{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorityInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issued_by",
    "seal_id",
    "issued_to",
    "scope",
    "constraints",
    "issued_at",
    "expires_at",
    "protocol",
    "status"
  ],
  "properties": {
    "issued_by": {
      "type": "string",
      "description": "Authority issuer identifier recognized through AUCTORISEAL trusted roots."
    },
    "seal_id": {
      "type": "string",
      "description": "Globally unique authority seal identifier."
    },
    "issued_to": {
      "type": "string",
      "description": "Subject receiving the authority seal."
    },
    "scope": {
      "type": "array",
      "description": "Canonical scope entries emitted by AUCTORISEAL.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "constraints": {
      "type": "object",
      "description": "Additional limiting constraints emitted by AUCTORISEAL.",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "issued_at": {
      "type": "integer",
      "description": "Unix epoch timestamp in milliseconds when the seal was issued."
    },
    "expires_at": {
      "type": ["integer", "null"],
      "description": "Optional expiration timestamp in milliseconds."
    },
    "protocol": {
      "type": "integer",
      "description": "Authority protocol version."
    },
    "status": {
      "type": "string",
      "enum": ["active", "revoked"],
      "description": "Current seal status."
    },
    "metadata": {
      "type": "object",
      "description": "Non-normative metadata.",
      "additionalProperties": true
    }
  }
}
